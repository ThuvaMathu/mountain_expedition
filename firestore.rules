rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 1. Admin Access ---
    // The Admin has full read and write access to the entire database via a wildcard.
    // This allows Admins to bypass any further restrictions on specific collections.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- 2. Guest/Public Access (Public Content) ---
    // Global read access for unauthenticated visitors, but with zero write permissions.
    match /mountains/{document} { allow read: if true; }
    match /tourist-packages/{document} { allow read: if true; }
    match /posters/{document} { allow read: if true; }
    match /posts/{document} { allow read: if true; }
    match /events/{document} { allow read: if true; }
    match /gallery/{document} { allow read: if true; }
    match /videos/{document} { allow read: if true; }
    match /awards/{document} { allow read: if true; }
    match /testimonials/{document} { allow read: if true; }
    match /settings/{document} { allow read: if true; }

    // --- 3. User Access ---
    // Authenticated users have access restricted strictly to their own data.
    
    match /users/{userId} {
      // Users can only read and update their own profile data.
      allow read, update: if isOwner(userId);
    }
    
    match /journeyImages/{imageId} {
      // Restricted to creation and reading of user's own data.
      allow create: if isAuthenticated() && request.resource.data.userEmail == request.auth.token.email;
      allow read: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
    }

    match /experienceSubmissions/{submissionId} {
      // Restricted to creation and reading of user's own submissions.
      allow create: if isAuthenticated() && request.resource.data.userEmail == request.auth.token.email;
      allow read: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
    }

    match /enquiries/{enquiryId} {
      // Allows authenticated users to send an enquiry, and only read their own.
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
    }

    // --- 4. Payment Specifics ---
    // Specific, strict rules for payment-related data to ensure high security.
    // Notice that updates and deletes are inherently disallowed here for users.
    
    match /orders/{orderId} {
      // Allow creation, update and read of orders (required for backend API using standard client SDK)
      // Since order IDs are secure random strings, allowing read helps the backend verify payments.
      allow create, update, read: if true;
    }

    match /bookings/{bookingId} {
      // Allow backend to create and update bookings using standard client SDK after payment success.
      allow create, update: if true;
      // Users can only read their own bookings.
      allow read: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
    }
  }
}
